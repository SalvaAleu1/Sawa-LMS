# Frontend-safe Supabase values only (never place service-role keys here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base URL for the deployed Cloudflare Worker API, e.g. https://api.example.com
VITE_API_BASE_URL=

# Configure these as Cloudflare Worker variables/secrets, never in VITE_*:
# APP_ENV=production
# APP_BASE_URL=https://your-sawalearn-frontend-domain
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<Cloudflare secret; never expose to the browser>
# RESEND_API_KEY=<optional, for email delivery when notification endpoints are implemented>
